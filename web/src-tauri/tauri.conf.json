{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chips",
  "version": "0.1.0",
  "identifier": "ir.wwts.chips",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chips",
        "width": 1200,
        "height": 760,
        "minWidth": 360,
        "minHeight": 560,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icon.ico"
    ],
    "externalBin": [
      "binaries/ts-connector"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "licenseFile": "../../LICENSE",
    "resources": [
      "../../LICENSE",
      "../../tsclientlib/LICENSE-MIT",
      "../../tsclientlib/LICENSE-APACHE"
    ]
  }
}
